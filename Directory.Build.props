<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Version shown inside the app. Release builds override it from the git tag. -->
    <Version>1.0.1</Version>
    <Product>Shader Studio for FiveM</Product>
    <Authors>Shader Studio contributors</Authors>
    <Company>Shader Studio</Company>
    <RepositoryUrl>https://github.com/Kaofan1/ShaderStudio</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

</Project>
